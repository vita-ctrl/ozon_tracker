# Absolute origin of the API gateway (no trailing slash, no path).
# Dev: core service directly. Prod: the deployed gateway / API host.
VITE_API_BASE=http://localhost:8004

# Which product data source to use:
#   "local" (default) — real product data from the parser service, saved in localStorage
#   "mock"            — hardcoded demo data
#   "api"             — the (not yet implemented) core_service products API
VITE_PRODUCTS_SOURCE=local
